INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-this-influx-password
INFLUXDB_ORG=atmos
INFLUXDB_BUCKET=wind_telemetry
INFLUXDB_TOKEN=change-this-influx-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
TTN_BROKER=eu1.cloud.thethings.network
TTN_PORT=8883
TTN_APP_ID=your-ttn-application-id
TTN_API_KEY=NNSXS.your-ttn-api-key
INFLUX_URL=http://influxdb:8086
LOG_LEVEL=INFO
INFLUXDB_RETENTION=90d
# Alert thresholds. Adjust EXPECTED_INTERVAL_SECONDS to the real device cadence.
EXPECTED_INTERVAL_SECONDS=120
STALE_MISSED_CYCLES=3
SPOOL_ALERT_SECONDS=300
